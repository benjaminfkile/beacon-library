{
  "schemaVersion": 1,
  "backoffMs": [1000, 2000, 3000, 5000],
  "joinDeniedFirstWaitMs": 10000,
  "scenarios": [
    {
      "name": "transport close while connected",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 1 },
        { "hub": "close", "error": "WebSocket closed with status code: 1006" },
        { "expect": "reconnecting", "delayMs": 1000 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 2, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "clean close while connected",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1 },
        { "hub": "close" },
        { "expect": "reconnecting", "delayMs": 1000 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 2, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "close during the handshake",
      "steps": [
        { "hub": "close", "error": "WebSocket closed with status code: 1006" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "close during the join",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "close", "error": "WebSocket closed with status code: 1006" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "handshake never settles then the connection closes",
      "steps": [
        { "hub": "startNeverSettles" },
        { "hub": "close", "error": "1006 during hanging handshake" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "join never settles then the connection closes",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinNeverSettles" },
        { "hub": "close", "error": "1006 during hanging join" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "start rejects",
      "steps": [
        { "hub": "startRejects" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "join rejects",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinRejects" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "join denied waits ten seconds first",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinDenied" },
        { "expect": "reconnecting", "delayMs": 10000, "hubsBuilt": 1 },
        { "advanceMs": 10000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "evicted auth_expired rejoins on the same connection",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "rejoinCount": 0, "hubsBuilt": 1 },
        { "hub": "evict", "reason": "auth_expired" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "rejoinCount": 1, "hubsBuilt": 1 }
      ]
    },
    {
      "name": "evicted for another reason reconnects",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 1 },
        { "hub": "evict", "reason": "service_removed" },
        { "advanceMs": 2000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 2, "hubsBuilt": 2 }
      ]
    },
    {
      "name": "hub build throws",
      "steps": [
        { "hub": "buildThrows" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 0 },
        { "advanceMs": 1000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 1 }
      ]
    },
