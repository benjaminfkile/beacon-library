    {
      "name": "stop during a backoff wait",
      "steps": [
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 1 },
        { "hub": "close", "error": "1006" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 1 },
        { "advanceMs": 500 },
        { "stop": true },
        { "advanceMs": 2000 },
        { "expect": "disconnected", "hubsBuilt": 1 }
