{
  "name": "beacon-library",
  "version": "0.1.0",
  "description": "The WMSFO v2 beacon core for Node: hub socket loop, send loop, heartbeat loop, REST client, and the leader monitor.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "conformance",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:check": "node scripts/check-contracts.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@microsoft/signalr": "8.0.7"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
