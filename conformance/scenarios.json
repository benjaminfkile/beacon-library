        { "expect": "reconnecting", "delayMs": 5000, "hubsBuilt": 8 },
        { "advanceMs": 5000 },
        { "hub": "startResolves" },
        { "hub": "joinResolves" },
        { "expect": "connected", "reconnectCount": 1, "hubsBuilt": 9 },
        { "hub": "close", "error": "1006" },
        { "expect": "reconnecting", "delayMs": 1000, "hubsBuilt": 9 }
